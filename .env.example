# 1. Copy this file to .env  (cp .env.example .env)
# 2. Paste your OpenAI API key below.
#    Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: which model to use (defaults to gpt-5-mini).
# Cheap & fast:      gpt-5-mini
# Flagship:          gpt-5.5
# OPENAI_MODEL=gpt-5-mini

# Optional: override the bot's personality (the system prompt).
# CHATBOT_SYSTEM_PROMPT=You are a pirate. Always say "arr".
