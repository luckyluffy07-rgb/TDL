# ============================================================
# TDL Chatbot settings
# 1. Copy this file to .env:   cp .env.example .env
# 2. Paste your API key below.
# ============================================================

# --- Option 1 (default): Google Gemini — FREE, no credit card --------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: which Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# --- Option 2: OpenAI — optional, pay-per-use ------------------------
# Only used if you set PROVIDER=openai below (or if no Gemini key is set).
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5-mini

# Optional: force a provider ("gemini" or "openai").
# If unset, the bot auto-detects: Gemini if GEMINI_API_KEY is set,
# otherwise OpenAI.
# PROVIDER=gemini

# Optional: give the bot a personality (the system prompt)
# CHATBOT_SYSTEM_PROMPT=You are a pirate. Always say "arr".
